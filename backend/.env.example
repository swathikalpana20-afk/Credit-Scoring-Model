# CreditWise AI — Environment Variables Example
# Copy this file to .env and fill in values

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./creditwise.db

# No secrets required for the demo build
# Add API keys here if integrating external services in the future
